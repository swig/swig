# Experimental WebAssembly JavaScript tests.
srcdir = @srcdir@
top_builddir = @top_builddir@
SWIG = $(top_builddir)/preinst-swig
EMCXX = @EMCXX@
NODE = @WASM_NODE@
TSC = @WASM_TSC@
EMCXXFLAGS = -O0 -Werror -fwasm-exceptions
SHARED_TEST_CASES = \
	li_std_pair \
	li_std_vector_enum
TEST_CASES = \
	basic \
	constants \
	constructor_handle \
	director \
	enum_widths \
	extend \
	li_std_pair \
	li_std_vector_enum \
	overload \
	primitive_fragments \
	scalar_references \
	stl_containers \
	stl_legacy_vector \
	stl_nested \
	stl_ownership \
	stl_references \
	stl_typemaps \
	stl_values \
	typemap_cleanup

.PHONY: check partialcheck unsupported clean distclean
check: $(TEST_CASES:=.cpptest) unsupported

partialcheck: $(TEST_CASES:=.generate) unsupported

%.generate:
	$(SWIG) -w524 -Werror -c++ -wasm-js -stubs -o $*_wrap.cxx $(if $(filter $(SHARED_TEST_CASES),$*),$(srcdir)/../$*.i,$(srcdir)/$*.i)

%.cpptest:
	$(SWIG) -w524 -Werror -c++ -wasm-js -stubs -o $*_wrap.cxx $(if $(filter $(SHARED_TEST_CASES),$*),$(srcdir)/../$*.i,$(srcdir)/$*.i)
	$(EMCXX) $(EMCXXFLAGS) -lembind $*_wrap.cxx -sMODULARIZE=1 -sEXPORT_NAME=createWasm -sEXPORTED_RUNTIME_METHODS='["UTF8ToString","lengthBytesUTF8","stringToUTF8","count_emval_handles"]' -sEXPORTED_FUNCTIONS=@$*_wrap.cxx.exports -o $*_wrap_wasm.js
	cp $(srcdir)/$*_runme.js $*_test.js
	$(NODE) $*_test.js
	cp $(srcdir)/$*_types.ts $*_test.ts
	$(TSC) --noEmit --strict --target ES2020 --module commonjs $*_test.ts

clean:
	rm -f *_wrap* *_test.js *_test.ts unsupported_*.cxx* unsupported_*.js unsupported_*.log

distclean: clean
	rm -f Makefile

unsupported:
	@for name in global import; do \
	  if $(SWIG) -w524 -Werror -c++ -wasm-js -o unsupported_$$name.cxx $(srcdir)/unsupported_$$name.i >unsupported_$$name.log 2>&1; then \
	    cat unsupported_$$name.log; exit 1; \
	  fi; \
	  grep -q "is not supported by -wasm-js" unsupported_$$name.log || { cat unsupported_$$name.log; exit 1; }; \
	done
