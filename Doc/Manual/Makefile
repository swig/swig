# Makefile for generating the SWIG documentation
#
# Note that the htmldoc, weasyprint, tidy and poppler-utils packages need to be installed.
#
# The .html files are first processed and updated with chapter numbering and heading ids
# using the python scripts. The htmldoc program is then used to generate the single page HTML
# version of the documentation and fixstyle.py corrects and checks the links in it.
# WeasyPrint is used to generate the pdf document from the single page html file, with the
# page layout in page.css. checkpdf.py checks the pdf using pdftotext and pdffonts from poppler-utils.
# HTML TIDY (package also known as tidy) is also required and is used as an aid to HTML
# validation.
#
# Additional html validation can be done using the validate and vnu-validate targets.
# Additional link checking can be done using the linkchecker1, linkchecker2 and linkchecker3 targets.
#
SWIG_PDF:=SWIGDocumentation.pdf
SWIG_HTML:=SWIGDocumentation.html
SWIG_SECTIONS:=Sections.html
SWIG_INDEX:=index.html
SWIG_BOOK:=swightml.book
SWIG_CSS:=style.css
LINK_TMP:=linkchecker-tmp
SWIG_TITLE:=swig16.png
SWIG_CHAPTERS:=$(shell sed '/^\#/d' chapters)

# The command to run the Nu Html Checker
VNU = vnu

# Note the # and " are escaped
HTMLDOC_OPTIONS = "--book --toclevels 4 --no-numbered --toctitle \"Table of Contents\" --title --titleimage $(SWIG_TITLE) --linkcolor \#0000ff --linkstyle underline --size Universal --left 0.50in --right 0.50in --top 0.50in --bottom 0.50in --header .t. --footer h.1 --nup 1 --tocheader .t. --tocfooter ..i --portrait --color --no-pscommands --no-xrxcomments --compression=1 --jpeg=0 --fontsize 10.0 --fontspacing 1.2 --headingfont Helvetica --bodyfont Times --headfootsize 10.0 --headfootfont Helvetica --charset iso-8859-1 --links --no-embedfonts --pagemode outline --pagelayout single --firstpage c1 --pageeffect none --pageduration 10 --effectduration 1.0 --no-encryption --permissions all  --owner-password \"\"  --user-password \"\" --browserwidth 680"

.PHONY: all maketoc check check-anchors generate maintainer-clean clean-baks test validate vnu-validate linkchecker1 linkchecker2 linkchecker3

# Delete a generated document whose recipe fails so that it is generated again
.DELETE_ON_ERROR:

all: maketoc check generate

maketoc:
	python3 maketoc.py

# Use this to regenerate CCache.html should this ever be needed
CCache.html: ../../CCache/ccache.yo
	yodl2html -o $@ $^

# Tabs in the html files will stop the build - replace them with the appropriate number of spaces
# Use htmltidy to warn about some HTML errors. Note that it is not used to clean/tidy the HTML,
# it is just used as a primitive HTML checker. An error (exit status 2) in any file fails the check.
# CCache.html is generated by yodl2html and has a few insignificant problems, so we don't put it through tidy
# Over long lines in <pre> elements are also rejected as they get clipped in the pdf, see checklines.py and checkpdf.py
# A link whose anchor is not in the file it names is rejected too, see checklinks.py
check:
	all="index.html Sections.html `sed '/^#/d' chapters | grep -v CCache.html`" && for a in $$all; do echo "Check for tabs $$a" && if grep -P '\t' $$a; then echo "Please delete the tabs from the lines above" && exit 1; fi; done && for a in $$all; do echo "HTML tidy check $$a" && tidy -errors --gnu-emacs yes -quiet $$a || [ $$? -eq 1 ] || exit 1; done;
	python3 checklines.py
	python3 checklinks.py

# Check that no existing anchor has been renamed or removed since the current branch left the git revision BASE,
# see checkanchors.py. A renamed anchor fails the check, a removed anchor is a warning.
BASE = master
check-anchors:
	python3 checkanchors.py '$(BASE)'

# The WeasyPrint tool
# https://weasyprint.org/
# Debian/Ubuntu package: weasyprint
# WeasyPrint reports problems, such as a missing image or link target, without failing, so fail on any problem it reports
$(SWIG_PDF): $(SWIG_HTML) page.css
	{ weasyprint -s page.css $< $@ 2>&1 || echo "ERROR: weasyprint failed"; } | awk '{ print } /^(WARNING|ERROR|CRITICAL):/ { failed = 1 } END { exit failed }'

# The pdf is checked here rather than in its own rule, so that a pdf failing the check is kept to look at
generate: $(SWIG_PDF)
	python3 checkpdf.py $(SWIG_PDF)

# CCache.html is left out of the prerequisites, as its rule would regenerate it with yodl2html
$(SWIG_HTML): $(SWIG_BOOK) $(SWIG_SECTIONS) $(filter-out CCache.html,$(SWIG_CHAPTERS)) $(SWIG_CSS) fixstyle.py
	htmldoc --batch $<
	python3 fixstyle.py $@

$(SWIG_BOOK): chapters $(SWIG_SECTIONS)
	echo "#HTMLDOC 1.8.24" > $@
	echo -t html -f $(SWIG_HTML) $(HTMLDOC_OPTIONS) >> $@
	echo "$(SWIG_SECTIONS)" >> $@
	cat $< >> $@

maintainer-clean: clean-baks
	rm -f $(SWIG_BOOK) $(SWIG_HTML) $(SWIG_PDF)
	rm -rf $(LINK_TMP)

clean-baks:
	rm -f *.bak

test:
	grep "href=\".*\.html\"" index.html
	grep "href=\".*\.html\"" Sections.html
	all=`sed '/^#/d' chapters`; for a in $$all; do grep -l "href=\".*\.html\"" $$a; done;

# Validating using the WDG offline validator - http://www.htmlhelp.com/tools/validator/offline/
validate:
	for a in $(SWIG_CHAPTERS); do validate --emacs $$a; done;

# Alternatively, using the Nu Html Checker (vnu), https://validator.github.io/validator/
# It checks HTML5 only, so it reports the HTML 4.01 doctype of each chapter as an error.
# Set VNU to run it in a different way, for example: make vnu-validate VNU="java -jar vnu.jar"
vnu-validate:
	$(VNU) $(SWIG_CHAPTERS) $(SWIG_CSS)

# Link checking using linkchecker of the index.html only file
# The anchors of the links are checked by checklinks.py in the check target, as linkchecker 10 no longer has --anchors
linkchecker1:
	linkchecker --config=./linkchecker.config $(SWIG_INDEX)

# Check for links which don't work including those generated from the individual .html files into SWIGDocumentation.html
linkchecker2:
	rm -rf $(LINK_TMP)
	mkdir -p $(LINK_TMP)
	cp $(SWIG_HTML) $(LINK_TMP)
	cp *.png $(LINK_TMP)
	(cd $(LINK_TMP) && linkchecker --config=../linkchecker.config -F text --no-warnings $(SWIG_HTML))

# Check for relative links without an anchor (there shouldn't be any), they are broken links in the single page html and
# pdf documentation. For example, href="SWIG.html" needs to be href="SWIG.html#SWIG". Only index.html links to these two.
linkchecker3:
	@echo "Checking that all links have an anchor (with a #) or are a full url beginning http"
	! grep 'href="' *.html | sed -e 's/.*href="\(.*\)">.*$$/\1/' | grep -v "#" | grep -v "^http" | grep -v "^$(SWIG_CSS)" | grep -v -x -e "$(SWIG_HTML)" -e "$(SWIG_PDF)"
